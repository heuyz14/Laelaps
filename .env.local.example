# Copy this file to apps/web/.env.local for local Next.js development.
# Do not commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only OpenRouter AI configuration. Never prefix these with NEXT_PUBLIC_.
# Only free OpenRouter models are accepted: use openrouter/free or a model ID ending in :free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
